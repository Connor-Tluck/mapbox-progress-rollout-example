# Mapbox public access token (pk.…). Required.
# https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# LaunchDarkly server-side SDK key (sdk-…). Optional.
# When set, the map reflects the real flag. When empty, the app runs a simulated rollout.
LD_SDK_KEY=

# Boolean flag key to evaluate. Defaults to service-area-rollout.
LD_FLAG_KEY=service-area-rollout
